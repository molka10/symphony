{% extends 'base.html.twig' %}

{% block title %}Livres entre {{ start|date('Y-m-d') }} et {{ end|date('Y-m-d') }}{% endblock %}

{% block body %}
<h1 style="text-align:center">
    Livres publiés entre {{ start|date('Y') }} et {{ end|date('Y') }}
</h1>

<p style="text-align:center">
    <a href="{{ path('app_book_list') }}" class="btn btn-primary">Retour à la liste complète</a>
</p>

<table border="1" cellpadding="6" cellspacing="0" align="center">
    <thead>
        <tr>
            <th>REF</th>
            <th>Titre</th>
            <th>Catégorie</th>
            <th>Date de publication</th>
            <th>Publié</th>
            <th>Auteur</th>
        </tr>
    </thead>
    <tbody>
        {% for b in books %}
        <tr>
            <td>{{ b.id }}</td>
            <td>{{ b.title }}</td>
            <td>{{ b.category }}</td>
            <td>{{ b.publicationDate ? b.publicationDate|date('Y-m-d') : '' }}</td>
            <td>{{ b.enabled ? 'Oui' : 'Non' }}</td>
            <td>{{ b.author ? b.author.username : '' }}</td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6" style="text-align:center">Aucun livre trouvé pour cette période</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
