{% extends 'base.html.twig' %}
{% block title %}Recherche Auteurs{% endblock %}

{% block body %}
<h1 style="text-align:center">Recherche Auteurs (min/max)</h1>

<div style="width:420px; margin: 0 auto 16px auto;">
  {{ form_start(form, { method: 'GET' }) }}
    {{ form_row(form.minBooks) }}
    {{ form_row(form.maxBooks) }}
    {{ form_row(form.search) }}
  {{ form_end(form) }}
</div>

<table border="1" cellpadding="6" cellspacing="0" align="center" width="60%">
  <thead>
    <tr>
      <th style="text-align:left;">Auteur</th>
      <th style="text-align:center;">Nb livres</th>
    </tr>
  </thead>
  <tbody>
    {% for a in authors %}
      <tr>
        <td>{{ a.username }}</td>
        <td style="text-align:center">
          {{ a.nbBooks ?? a.books|length }}
        </td>
      </tr>
    {% else %}
      <tr>
        <td colspan="2" style="text-align:center">Aucun auteur trouvé.</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
