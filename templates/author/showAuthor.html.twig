{% extends 'base.html.twig' %}

{% block title %}Détails Auteur{% endblock %}

{% block body %}
    <h1>{{ author.username }}</h1>
    <img src="{{ asset(author.picture) }}" alt="{{ author.username }}" width="200">
    <p>Email : {{ author.email }}</p>
    <p>Nombre de livres : {{ author.nb_books }}</p>

    <a href="{{ path('app_authors_list') }}">⬅ Retour à la liste</a>
{% endblock %}
