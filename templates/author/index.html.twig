{% extends 'base.html.twig' %}
{% block title %}Auteurs{% endblock %}
{% block body %}
<h1>Auteurs</h1>
<a href="{{ path('app_author_new') }}">+ Nouvel auteur</a>
<table border="1" cellpadding="6">
  <tr><th>ID</th><th>Nom</th><th>Email</th><th>Âge</th><th>Actions</th></tr>
  {% for a in authors %}
    <tr>
      <td>{{ a.id }}</td>
      <td><a href="{{ path('app_author_show', {id:a.id}) }}">{{ a.username }}</a></td>
      <td>{{ a.email }}</td>
      <td>{{ a.age }}</td>
      <td>
        <a href="{{ path('app_author_edit', {id:a.id}) }}">edit</a> |
        <a href="{{ path('app_author_delete', {id:a.id}) }}"
           onclick="return confirm('Supprimer ?');">delete</a>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="5">Aucun auteur</td></tr>
  {% endfor %}
</table>
{% endblock %}
